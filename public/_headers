/*
  # ─── 基础安全头（全站默认） ─────────────────────────────
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # COOP 用 same-origin-allow-popups 而非 same-origin：OAuth 登录弹窗
  # （github/google/gitee/qq/linuxdo）会先导航到跨域授权页再回到本站回调页，
  # 回调页靠 window.opener.postMessage 回传 token，same-origin 会掐断该链路。
  # allow-popups 仅隔离"本站被别人当弹窗打开"的场景，不影响自己开弹窗。
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  # 阻止其他站点以 no-cors 方式内嵌本站资源（防热点盗链/Spectre 类侧信道）；
  # 爬虫与 CORS fetch 不受影响。
  Cross-Origin-Resource-Policy: same-origin

  # ─── 内容安全策略 ──────────────────────────────────────
  #  - script-src 已移除 'unsafe-inline'（2026-10 安全加固）：唯一的内联脚本
  #    （index.html 版本守卫）改用 sha256 hash 放行。hash 由构建链末尾的
  #    scripts/gen-script-hashes.mjs 扫描 dist 产物自动计算并回写 dist/_headers，
  #    ⚠️ 所以手改 index.html 内联脚本后必须完整重新构建部署，否则脚本会被
  #    CSP 静默拦截（下方 hash 值为最近一次构建的产物，仅作 source 记录）。
  #    内联事件属性（onclick= 等）也被一并禁用；CSS preload 激活由版本守卫
  #    脚本里的捕获阶段 load 委托完成，不走 link 的 onload=""。
  #  - script-src 保留 'unsafe-eval'：Make24（new Function）与
  #    MathEquation3D（eval）两个工具依赖表达式动态求值；待它们改写成
  #    独立表达式解析器后方可移除。
  #  - style-src 保留 'unsafe-inline'：Element Plus 动态 style 属性 +
  #    index.html 内联首屏 CSS；脚本通道已锁死，样式注入风险可接受。
  #  - img-src 加 image.pollinations.ai：文生图工具直连 Pollinations。
  #  - img-src 加 data: blob:：Canvas 截图、Base64 图片、PDF.js worker 渲染。
  #  - connect-src *：AI 代理/外部 API 多为 * 调用（Agnes、Pollinations、Supabase 等）。
  #  - script-src / frame-src / style-src 加 https://giscus.app：评论区使用 giscus（加载 client.js、default.css 并内嵌 giscus iframe）。
#  - ⚠️ 已知非本项目问题：若控制台出现 "Executing inline script violates ...
#    script-src ... 需要另一个 sha256" 且该 hash 每次刷新都变，那是 Cloudflare
#    在边缘往每个 HTML 注入的 Bot 检测脚本（__CF$cv$params +
#    /cdn-cgi/challenge-platform/scripts/jsd/main.js，即 Bot Fight Mode 的
#    JavaScript Detections）。它内容含 ray ID + 时间戳、每请求都变，hash 放行
#    在数学上不可能；唯一根治 = Cloudflare 控制台 → fologde.com zone →
#    Security → Bots → 关闭 Bot Fight Mode（免费版 JSD 随 BFM 强制开启），
#    Pro+ 可只关 Super Bot Fight Mode 里的 JavaScript Detections。
#    验证：curl -s https://tool.fologde.com/ | grep __CF 应无输出。
#    不要为它加 'unsafe-inline'（会撤销整个 CSP 加固）。
#  - frame-src 加 4 个 jx.* 域名：视频解析工具（/video-parser/）内嵌的第三方解析线路 iframe。
#    与 VideoParser.vue 里 PARSE_LINES 的 url 保持同步；解析服务商换域名时此处需同步更新。
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'sha256-L8j/PFB8npmY0W8fE9/oRzIRKCqyVb2jn8TFRUtB7fI=' https://static.cloudflareinsights.com https://accounts.google.com https://giscus.app https://api.tianditu.gov.cn; style-src 'self' 'unsafe-inline' https://giscus.app; img-src 'self' data: blob: https:; media-src 'self' https: blob:; font-src 'self' data:; connect-src 'self' https: wss:; frame-src https://giscus.app https://jx.xmflv.com https://jx.m3u8.tv https://jx.playerjy.com https://jx.hls.one; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com

/js/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# sw.js 是不带 hash 的固定 URL、每次发版内容都变，必须每次回源校验。
# 2026-10 线上实测：no-cache 形式会被 Cloudflare zone 的 Browser Cache TTL(4h)
# 改写成 max-age=14400，浏览器 4 小时拿不到新 sw.js → 发版后旧 SW 滞留。
# 改用与 /index.html 相同的 no-store 形式（Browser Cache TTL 不改写 no-store）；
# main.ts 侧另有 register(..., { updateViaCache: 'none' }) 双保险，即使该规则
# 再被覆盖也不影响 SW 更新检查。
# （CF _headers 多规则同时命中时 header 会合并而不是覆盖，所以这里用精确规则，
# 避免与 /* 的默认头冲突）
/sw.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Content-Type: application/javascript; charset=utf-8

# 根路径其余 .js 只有内容 hash 的 workbox 运行时，可放心长缓存
/workbox-*.js
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/javascript; charset=utf-8

# /lib 下的第三方库（gif.js 等）不带 hash 但内容基本不变，保持长缓存
/lib/*
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: text/css; charset=utf-8

/index.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

# 用户实际访问的是根路径 /，必须同样标记 no-store，
# 否则 Cloudflare 默认的 max-age=0, must-revalidate 在多节点间存在毫秒级不一致，
# 与 _headers 的 /index.html 规则命中的是不同响应。
# 注意：CF Pages 资源规则按声明顺序匹配，根路径声明在前可避免被后续通配规则覆盖。
/
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

# /login 是唯一不在 _routes.json include 里的 SPA 路由（没有 Function 处理，
# 走静态 SPA fallback），_headers 按请求路径匹配，必须单独声明 no-store。
# 其余全部页面路由（/skill-poster/ 等）由 functions/_middleware.js 在返回
# HTML 时统一 set no-store（2026-10 深链白屏事故：max-age=0 会被 zone 的
# Browser Cache TTL 改写成 max-age=14400，发版后旧 HTML 引用已删的旧
# hash chunk → 白屏）。
/login
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

