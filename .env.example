# ============================================================
# 环境变量示例文件
# 复制本文件为 .env.development / .env.production 后按需修改
# 浏览器侧可读取的变量必须以 VITE_ 为前缀（Vite 规则）
# ============================================================

# ---------- 基础环境 ----------
# 运行环境标识：development（开发） / production（生产）
NODE_ENV=development

# 自定义 dev server 启动 host
VITE_HOST=127.0.0.1

# ---------- 站点信息（用于 SEO / title / 页脚展示） ----------
# 网站名称（导航栏、页脚、页面 title 拼接）
VITE_APP_TITLE=一方工具箱
# 弹幕循环基础间隔（毫秒）
VITE_BARRAGE_INTERVAL_MS=300
# 站点简短描述（页脚、页面 title 拼接）
VITE_APP_DESC=一个轻量的在线工具箱
# 站点完整域名（用于 SEO canonical、JWT iss/aud、Functions 代理拼接等）
VITE_SITE_URL=https://tool.fologde.com
# 站长个人站点地址（关于页展示）
VITE_MY_SITE_ADDR=https://www.fologde.com

# ---------- 仓库地址（关于页、评论、提示语展示） ----------
# 本仓库（fork）地址
VITE_GIT_URL=https://github.com/your-name/tools-web
# 上游原始仓库地址
VITE_RAW_GIT_URL=https://github.com/naroat/tools-web

# ---------- HTTP 请求 ----------
# API 前缀，所有请求会拼上该路径
VITE_APP_BASE_API=/v1
# 后端服务地址（最终 baseURL = VITE_SERVE + VITE_APP_BASE_API）
# 本地开发可留空走 Mock 或 Vite 代理
VITE_SERVE=
# 是否走本地 Mock：true 时使用 VITE_APP_BASE_API，否则拼接 VITE_SERVE
VITE_IS_MOCK=true

# ---------- UI / 运营位 ----------
# 第三方反馈互动地址（侧边栏"反馈"按钮跳转）
VITE_FEEDBACK_URL=
# 广告位开关：true 显示广告位，false 隐藏
VITE_ADV_SHOW=false

# ---------- AI 供应商 ----------
# AI 对话统一走站内代理（/api/ai-proxy，密钥在服务端），前端无需任何 AI 密钥。
# AI 文生图历史记录最大保留数量（localStorage 中保存的条数）
VITE_AI_IMAGE_HISTORY_MAX=50

# ---------- 谷歌登录 ----------
# Google OAuth Client ID（前端用）
VITE_GOOGLE_CLIENT_ID=

# ---------- Supabase（临时聊天 / 表白墙 / 五子棋） ----------
# 前端不持有任何 Supabase URL/密钥：supabase-js 走同源 /sb 代理
# （functions/sb/[[path]].js），服务端凭据配置在 Cloudflare Pages 环境变量：
#   SUPABASE_URL          Supabase 项目 URL
#   SUPABASE_SERVICE_KEY  service_role key（本地开发放 .dev.vars）

# ---------- 天地图（旅游地图 /travel-map/ 的底图）----------
# 在 https://console.tianditu.gov.cn/ 申请「浏览器端」类型的 tk 密钥，
# 并把使用到的域名加进该密钥的白名单：localhost、127.0.0.1、以及线上域名。
# 浏览器端密钥本身会暴露在前端请求里，靠域名白名单防盗用，因此可以明文放这里。
VITE_TIANDITU_KEY=

# ---------- 搜索引擎主动推送（需要 pnpm deploy:cf --push 才会触发）----------
# 站点完整域名（必须 https 公网域名，localhost / 127.0.0.1 / *.local 一律拒绝推送）
SITE_ORIGIN=https://tool.fologde.com

# 百度站长平台「主动推送（实时）」token（在 ziyuan.baidu.com 验证站点后获得）
BAIDU_PUSH_TOKEN=

# IndexNow key（覆盖 Bing / Yandex / Seznam / Naver）：8~128 位随机字符串
# 需要在站点根目录放 https://你的域名/<key>.txt，文件内容就是这个 key
INDEXNOW_KEY=
INDEXNOW_KEY_LOCATION=

# Google sitemap ping（不需要 token）；不需要时设 0
GOOGLE_PING_SITEMAP=1
